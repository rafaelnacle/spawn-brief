{
  "name": "spawnbrief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt src scripts *.ts *.json index.html README.md docs",
    "format:check": "oxfmt --check src scripts *.ts *.json index.html README.md docs",
    "test": "node --experimental-strip-types --test src/services/mappers.test.ts src/i18n/locale.test.ts src/features/content/contentPolicy.test.ts",
    "sync:data": "node scripts/sync-data.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "date-fns": "4.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
